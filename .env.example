# Server only. Leave blank for synthetic demo mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional backend credential for reviewed published search. Keep it server-only.
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PORT=3001

# Local-only collected-source preview (disabled automatically in production).
# Run node scripts/build-local-catalogue.mjs first; uses merchant image URL references.
# Set false to use the reviewed published Supabase catalogue instead.
CATALOGUE_LOCAL_PREVIEW=true
# Optional local JSON produced by scripts/export-marketplace-reviews.sql.
CATALOGUE_REVIEW_PATH=data/marketplace-reviews.json
